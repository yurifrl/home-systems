          "rawQuery": true,
          "rawSql": "SELECT\n  TIMESTAMP(day) AS time,\n  service AS metric,\n  cost AS value\nFROM (\n  SELECT\n    DATE(usage_start_time, 'America/Sao_Paulo') AS day,\n    service.description AS service,\n    ROUND(SUM(cost + IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c), 0)), 2) AS cost\n  FROM `syscd-443112.billing_export.gcp_billing_export_resource_v1_000600_2E9369_0C8480`\n  WHERE $__timeFilter(usage_start_time)\n  GROUP BY day, service\n)\nORDER BY time",
          "refId": "A"
        }
