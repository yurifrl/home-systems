          "rawSql": "SELECT\n  IFNULL((SELECT l.value FROM UNNEST(labels) l WHERE l.key = 'storage.googleapis.com/bucket-name'), '(none)') AS bucket,\n  ROUND(SUM(cost + IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c), 0)), 2) AS cost\nFROM `syscd-443112.billing_export.gcp_billing_export_resource_v1_000600_2E9369_0C8480`\nWHERE service.description = 'Cloud Storage'\n  AND $__timeFilter(usage_start_time)\nGROUP BY bucket\nHAVING cost > 0\nORDER BY cost DESC",
