          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(\n  SUM(cost + IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c), 0))\n    * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE('America/Sao_Paulo')))\n    / EXTRACT(DAY FROM CURRENT_DATE('America/Sao_Paulo'))\n, 2) AS cost\nFROM `syscd-443112.billing_export.gcp_billing_export_resource_v1_000600_2E9369_0C8480`\nWHERE DATE(usage_start_time, 'America/Sao_Paulo') >= DATE_TRUNC(CURRENT_DATE('America/Sao_Paulo'), MONTH)",
          "refId": "A"
        }
      ],
